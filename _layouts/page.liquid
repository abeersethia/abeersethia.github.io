---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post{% if page.url contains '/projects/' and page.url != '/projects/' %} case-study{% endif %}">
  {% if page.url contains '/projects/' and page.url != '/projects/' %}
    <nav class="case-study__back" aria-label="Back to projects">
      <a class="case-study__back-link btn-doss btn-doss--ghost" href="{{ '/projects/' | relative_url }}">← All work</a>
    </nav>
  {% endif %}

  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.url contains '/projects/' and page.url != '/projects/' %}
    {% if page.github %}
      <div class="page-actions">
        <a class="btn-doss btn-doss--primary" href="{{ page.github }}" target="_blank" rel="noopener noreferrer">View code</a>
      </div>
    {% endif %}
    {% include contact-cta.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
