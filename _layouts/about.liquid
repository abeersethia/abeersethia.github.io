---
layout: default
---
{% assign p = site.data.portfolio %}
<div class="post portfolio-home doss-page doss-page--centered">
  <section class="hero-section" aria-label="Introduction">
    <div class="hero hero--centered">
      <div class="hero__text">
        <h1 class="hero__title">
          {% if site.title == 'blank' %}
            {{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>
        {% if p.hero.role %}
          <p class="hero__role">{{ p.hero.role }}</p>
        {% endif %}
        <p class="hero__desc">{{ p.hero.subtitle }}</p>
        <div class="hero__actions">
          <a class="btn-doss btn-doss--primary" href="{{ p.buttons.work.url | relative_url }}">{{ p.buttons.work.label }}</a>
          <a class="btn-doss btn-doss--primary" href="{{ p.buttons.cv.url | relative_url }}" target="_blank" rel="noopener noreferrer">{{ p.buttons.cv.label }}</a>
        </div>
      </div>
    </div>
  </section>

  {% if page.social %}
    <div class="hero-contact-band">
      <div class="hero__links portfolio-social-links">{% include portfolio_social_links.liquid %}</div>
    </div>
  {% endif %}

  {% include logo-strip.liquid %}

  <article class="portfolio-body portfolio-body--centered">
    <section class="intro-section" id="intro">
      <div class="clearfix">{{ content }}</div>
    </section>

    {% include stack-strip.liquid %}

    {% if p.current_focus %}
      <section class="about-block" id="focus" aria-labelledby="focus-heading">
        <h2 class="section-title" id="focus-heading">Current focus</h2>
        <ul class="about-list">
          {% for item in p.current_focus %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}
  </article>
</div>
