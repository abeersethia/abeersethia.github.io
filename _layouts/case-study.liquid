---
layout: default
---
<div class="post case-study">
  <nav class="case-study__back" aria-label="Back to projects">
    <a class="case-study__back-link btn-doss btn-doss--ghost" href="{{ '/projects/' | relative_url }}">← All work</a>
  </nav>

  <header class="case-study__header">
    <p class="case-study__eyebrow">
      {% include project_category_slugs.liquid project=page %}
      {% if project_cat_label != '' %}{{ project_cat_label }}{% else %}Case study{% endif %}
    </p>
    <h1 class="post-title case-study__title">{{ page.title }}</h1>
    <p class="post-description case-study__lede">{{ page.description }}</p>

    {% if page.metrics %}
      <ul class="case-study__metrics" aria-label="Project metrics">
        {% for m in page.metrics %}
          <li class="case-study__metric">
            <span class="case-study__metric-value">{{ m.value }}</span>
            <span class="case-study__metric-label">{{ m.label }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if page.github or page.certificate or page.ppt or page.mid_term_presentation %}
      {% include case-study-attachment-actions.liquid project=page dialog_id_prefix='case-study' %}
    {% endif %}
  </header>

  {% if page.certificate or page.ppt or page.mid_term_presentation %}
    {% include case-study-attachment-dialogs.liquid project=page dialog_id_prefix='case-study' doc_title=page.title %}
  {% endif %}

  <div class="row case-study__layout">
    <aside class="col-lg-3 case-study__sidebar-col">
      <nav id="case-study-toc" class="case-study-toc sticky-top" aria-label="Case study sections"></nav>
    </aside>
    <article class="col-lg-9 case-study__body portfolio-markdown">
      {{ content }}
    </article>
  </div>

  {% if page.github %}
    <div class="page-actions">
      <a class="btn-doss btn-doss--primary" href="{{ page.github }}" target="_blank" rel="noopener noreferrer">View code</a>
    </div>
  {% endif %}

  {% include contact-cta.liquid %}
</div>
