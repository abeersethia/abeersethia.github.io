{% assign tools = site.data.portfolio.stack %}
{% if tools and tools.size > 0 %}
  <section class="about-block" id="stack" aria-labelledby="stack-heading">
    <h2 class="section-title" id="stack-heading">Tech stack</h2>
    <ul class="stack-strip__list">
      {% for tool in tools %}
        <li class="stack-strip__item">{{ tool }}</li>
      {% endfor %}
    </ul>
  </section>
{% endif %}
