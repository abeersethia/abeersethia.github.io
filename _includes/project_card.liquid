{% comment %}
  Project card — image, metrics, minimal actions (no hover video, no glass).
{% endcomment %}
{% include project_category_slugs.liquid project=project %}
<article class="project-card card h-100" data-categories="{{ project_cat_slugs }}">
  {% if project.img %}
    <a
      class="project-card__media"
      href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}"
      {% if project.redirect %}
        target="_blank" rel="noopener noreferrer"
      {% endif %}
    >
      {% assign img_path = project.img %}
      {% unless img_path contains 'assets/' %}
        {% assign img_path = project.img | prepend: 'assets/img/' %}
      {% endunless %}
      {% include figure.liquid path=img_path class="project-card__img" alt=project.title loading="lazy" %}
    </a>
  {% endif %}

  <div class="card-body">
    {% if project_cat_label != '' %}
      <p class="project-card__category">{{ project_cat_label }}</p>
    {% endif %}
    <h3 class="card-title">{{ project.title }}</h3>
    <p class="card-text">{{ project.description }}</p>

    {% if project.metrics %}
      <ul class="project-card__metrics">
        {% for m in project.metrics %}
          <li><span class="project-card__metric-value">{{ m.value }}</span> {{ m.label }}</li>
        {% endfor %}
      </ul>
    {% endif %}

    <div class="project-card__actions">
      {% if project.redirect %}
        <a class="btn-doss btn-doss--primary" href="{{ project.redirect }}" target="_blank" rel="noopener noreferrer">View project</a>
      {% else %}
        <a class="btn-doss btn-doss--primary" href="{{ project.url | relative_url }}">Case study</a>
      {% endif %}
      {% if project.github %}
        <a class="btn-doss btn-doss--ghost" href="{{ project.github }}" target="_blank" rel="noopener noreferrer">Code</a>
      {% endif %}
    </div>
  </div>
</article>
