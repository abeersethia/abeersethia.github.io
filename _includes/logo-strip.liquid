{% assign strip = site.data.portfolio.institutions %}
{% if strip and strip.items and strip.items.size > 0 %}
  <section class="logo-strip logo-strip--impact" aria-label="Institutions and employers">
    <p class="logo-strip__label">{{ strip.label | default: 'Technical Footprint' }}</p>
    <ul class="logo-strip__list">
      {% for brand in strip.items %}
        <li class="logo-strip__item">
          {% if brand.logo %}
            <img
              src="{{ brand.logo | relative_url }}"
              alt="{{ brand.name | default: 'Partner institution' }}"
              class="logo-strip__img logo-strip__img--mono"
              width="96"
              height="44"
              loading="lazy"
            >
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </section>
{% endif %}
