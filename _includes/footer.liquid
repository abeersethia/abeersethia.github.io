{% capture footer_contents %}
  <nav class="site-footer__social portfolio-social-links" aria-label="Social and contact links">
    {% include portfolio_social_links.liquid %}
  </nav>
  <p class="site-footer__copy">
    &copy; Copyright {{ site.time | date: '%Y' }}
    {{ site.first_name }}
    {{ site.middle_name }}
    {{ site.last_name }}. {{ site.footer_text }}
    {% if site.impressum_path %}
      <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
    {% endif %}
    {% if site.last_updated %}
      Last updated: {{ 'now' | date: '%B %d, %Y' }}.
    {% endif %}
  </p>
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="site-footer fixed-bottom" role="contentinfo"{% if site.enable_liquid_glass %} data-liquid-ignore{% endif %}>
    <div class="container mt-0 site-footer__inner">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="site-footer sticky-bottom mt-5" role="contentinfo"{% if site.enable_liquid_glass %} data-liquid-ignore{% endif %}>
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container site-footer__inner">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
